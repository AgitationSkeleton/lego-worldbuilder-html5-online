// World Builder Online's server (a Cloudflare Worker): the score tables, in D1, and races
// (a Race Durable Object for each).
// See README.md here for deploying it.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "worldbuilder-server",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	// The score tables.  `npx wrangler d1 create worldbuilder` prints the id to put here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "worldbuilder",
			"database_id": "0a3a71b6-2e10-4688-a2d7-5a58516008d6"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "RACE",
				"class_name": "Race"
			},
			{
				"name": "LOBBY",
				"class_name": "Lobby"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Race"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Lobby"
			]
		}
	],
	"vars": {
		// Pages that may use the server (app://game is the app, client/; a trailing :* allows
		// any port, for testing locally).
		"ALLOWED_ORIGINS": "https://wbonline.viosarcade.xyz,app://game,http://localhost:*,http://127.0.0.1:*"
	},
	// The server's address.  viosarcade.xyz must be a zone on this Cloudflare account; the
	// address and its certificate are made on the first deploy.
	"routes": [
		{
			"pattern": "wbserver.viosarcade.xyz",
			"custom_domain": true
		}
	]
}
